{
    "multipart": [
        {
            "when": {
                "shape": "panel",
                "facing": "north"
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence",
                "y": 0
            }
        },
        {
            "when": {
                "shape": "panel",
                "facing": "south"
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence",
                "y": 180
            }
        },
        {
            "when": {
                "shape": "panel",
                "facing": "east"
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence",
                "y": 90
            }
        },
        {
            "when": {
                "shape": "panel",
                "facing": "west"
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence",
                "y": 270
            }
        },
        {
            "when": {
                "shape": "straight_ns"
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence",
                "y": 90,
                "uvlock": true
            }
        },
        {
            "when": {
                "shape": "straight_ew"
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence",
                "y": 0,
                "uvlock": true
            }
        },
        {
            "when": {
                "shape": "junction"
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence_post",
                "uvlock": true
            }
        },
        {
            "when": {
                "shape": "junction",
                "north": true
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence_side",
                "uvlock": true
            }
        },
        {
            "when": {
                "shape": "junction",
                "south": true
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence_side",
                "y": 180,
                "uvlock": true
            }
        },
        {
            "when": {
                "shape": "junction",
                "east": true
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence_side",
                "y": 90,
                "uvlock": true
            }
        },
        {
            "when": {
                "shape": "junction",
                "west": true
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence_side",
                "y": 270,
                "uvlock": true
            }
        }
    ]
}
