{
    "multipart": [
        {
            "when": {
                "north": false,
                "south": false,
                "east": false,
                "west": false,
                "facing": "north"
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence",
                "y": 0
            }
        },
        {
            "when": {
                "north": false,
                "south": false,
                "east": false,
                "west": false,
                "facing": "south"
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence",
                "y": 180
            }
        },
        {
            "when": {
                "north": false,
                "south": false,
                "east": false,
                "west": false,
                "facing": "east"
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence",
                "y": 90
            }
        },
        {
            "when": {
                "north": false,
                "south": false,
                "east": false,
                "west": false,
                "facing": "west"
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence",
                "y": 270
            }
        },
        {
            "when": {
                "OR": [
                    {
                        "north": true
                    },
                    {
                        "south": true
                    },
                    {
                        "east": true
                    },
                    {
                        "west": true
                    }
                ]
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence",
                "uvlock": true
            }
        },
        {
            "when": {
                "north": true
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence_side",
                "uvlock": true
            }
        },
        {
            "when": {
                "south": true
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence_side",
                "y": 180,
                "uvlock": true
            }
        },
        {
            "when": {
                "east": true
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence_side",
                "y": 90,
                "uvlock": true
            }
        },
        {
            "when": {
                "west": true
            },
            "apply": {
                "model": "materia:block/wrought_iron_fence_side",
                "y": 270,
                "uvlock": true
            }
        }
    ]
}